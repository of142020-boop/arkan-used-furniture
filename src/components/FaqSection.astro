---
import { SITE, IMG_DIMS, whatsappUrl } from '../config/site';

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  eyebrow?: string;
  items: FaqItem[];
  splitVisual?: boolean;
  mainImage?: string;
  mainAlt?: string;
  insetImage?: string;
  insetAlt?: string;
}

const {
  title = 'إجابات واضحة لكل أسئلتك قبل البيع',
  eyebrow = 'الأسئلة الشائعة',
  items,
  splitVisual = false,
  mainImage = '/images/service-kitchens-carpets.webp',
  mainAlt = 'مندوب شركة أركان يعاين المطابخ والسجاد والنجف والأنتيكات المستعملة في مصر',
  insetImage = '/images/service-ac.webp',
  insetAlt = 'فني تكييف شركة أركان يفك ويعاين تكييف سبليت مستعمل مجاناً',
} = Astro.props;

const mainDims = IMG_DIMS[mainImage] || { w: 896, h: 1200 };
const insetDims = IMG_DIMS[insetImage] || { w: 896, h: 1200 };
---

<section class="section" id="faq">
  <div class="container">
    {splitVisual ? (
      <div class="faq-split">
        <div>
          <span class="eyebrow">{eyebrow}</span>
          <h2 class="section-title">{title}</h2>
          <div class="faq-list">
            {items.map((item, idx) => (
              <details class="faq-item" open={idx === 0}>
                <summary>
                  <span>{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">+</span>
                </summary>
                <p class="faq-answer">{item.a}</p>
              </details>
            ))}
          </div>
          <div style="margin-top:1.75rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
            <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
              اسألنا عبر واتساب الآن
            </a>
            <a href={SITE.phoneHref} class="btn btn-outline-dark">
              اتصل: {SITE.phoneDisplay}
            </a>
          </div>
        </div>

        <div class="faq-photos-stack" aria-hidden="true">
          <img src={mainImage} alt={mainAlt} width={mainDims.w} height={mainDims.h} class="faq-photo-main" loading="lazy" decoding="async" />
          <img src={insetImage} alt={insetAlt} width={insetDims.w} height={insetDims.h} class="faq-photo-inset" loading="lazy" decoding="async" />
        </div>
      </div>
    ) : (
      <div style="max-width:820px; margin-inline:auto;">
        <div class="text-center" style="margin-bottom:2rem;">
          <span class="eyebrow">{eyebrow}</span>
          <h2 class="section-title">{title}</h2>
        </div>
        <div class="faq-list">
          {items.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <p class="faq-answer">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
