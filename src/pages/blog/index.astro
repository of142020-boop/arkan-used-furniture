---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConversionBanner from '../../components/ConversionBanner.astro';
import { IMG_DIMS } from '../../config/site';
import { BLOG_ARTICLES } from '../../data/blog';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'المدونة وأدلة الأسعار', href: '/blog' },
];
---

<BaseLayout
  title="مدونة أركان | أدلة أسعار الأثاث والأجهزة المستعملة في مصر"
  description="أدلة شفافة ومحدثة لأسعار الأثاث المستعمل والتكييفات والثلاجات والغسالات والبوتاجازات والشاشات كسر الزيرو والخردة وأسواق المستعمل في مصر."
  canonicalPath="/blog"
  solidHeader={true}
  breadcrumbs={breadcrumbs}
>
  <section class="page-hero" style="padding-bottom:3rem;">
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a>
        <span>/</span>
        <span>المدونة وأدلة الأسعار</span>
      </nav>
      <span class="eyebrow">مركز المعرفة والتسعير العادل — أركان</span>
      <h1>أدلة أسعار الأثاث والأجهزة الكهربائية المستعملة في مصر</h1>
      <p class="hero-subtitle" style="margin-bottom:0;">
        تعرّف على متوسط أسعار السوق المصري حسب الماركة والحالة، وأشهر أسواق المستعمل، وأذكى طرق بيع عفشك وأجهزتك بأعلى قيمة كاش.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid" style="margin-top:0;">
        {BLOG_ARTICLES.map((post) => {
          const d = IMG_DIMS[post.heroImage] || { w: 896, h: 1200 };
          return (
            <article class="blog-card">
              <a href={`/blog/${post.slug}`}>
                <img src={post.heroImage} alt={post.h1} width={d.w} height={d.h} loading="lazy" decoding="async" />
              </a>
              <div class="blog-card-body">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
                  <span class="eyebrow" style="margin:0;">{post.category}</span>
                  <span style="font-size:0.78rem; color:var(--ink-muted);">{post.readTime}</span>
                </div>
                <h3><a href={`/blog/${post.slug}`}>{post.h1}</a></h3>
                <p>{post.excerpt}</p>
                <a href={`/blog/${post.slug}`} class="cat-tile-link">اقرأ الدليل الكامل ←</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <ConversionBanner />
</BaseLayout>
