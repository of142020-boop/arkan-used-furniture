---
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '@fontsource/cairo/800.css';
import '@fontsource/amiri/400.css';
import '@fontsource/amiri/700.css';
import '../styles/global.css';
import { SITE, NAV_LINKS, FOOTER_COLUMNS, whatsappUrl } from '../config/site';

export interface BreadcrumbItem {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  solidHeader?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  solidHeader = false,
  breadcrumbs = [],
  schemas = [],
} = Astro.props;

const cleanPath = canonicalPath === '/' ? '' : canonicalPath.replace(/\/+$/, '');
const canonicalUrl = `${SITE.domain}${cleanPath}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const baseSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE.domain}/#localbusiness`,
    name: SITE.brandFullName,
    alternateName: SITE.brandName,
    url: SITE.domain,
    image: `${SITE.domain}${SITE.defaultOgImage}`,
    telephone: '+201000000000',
    email: SITE.email,
    priceRange: '$$',
    areaServed: {
      '@type': 'Country',
      name: 'Egypt',
    },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '23:59',
    },
  },
];

if (breadcrumbs.length > 0) {
  baseSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.label,
      item: `${SITE.domain}${b.href === '/' ? '' : b.href}`,
    })),
  });
}

const allSchemas = [...baseSchemas, ...schemas];
const waLink = whatsappUrl();
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:site_name" content={SITE.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE.domain}${ogImage}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.domain}${ogImage}`} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <header class={`site-header${solidHeader ? ' solid' : ''}`} id="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-mark" aria-label={SITE.brandFullName}>
          <span class="brand-logo-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M4 20V10L12 4L20 10V20" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round" />
              <path d="M9 20V13H15V20" stroke="#EA521F" stroke-width="2" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="brand-text-wrap">
            <span class="brand-title">{SITE.brandName}</span>
            <span class="brand-sub">{SITE.brandEn} • EGYPT</span>
          </span>
        </a>

        <nav class="main-nav" aria-label="التنقل الرئيسي">
          {NAV_LINKS.map((item) => (
            <a href={item.href} class={currentPath === item.href ? 'active' : ''}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-white btn-sm">
            تقييم واتساب
          </a>
          <a href={SITE.phoneHref} class="btn btn-outline-light btn-sm">
            {SITE.phoneDisplay}
          </a>
        </div>

        <button
          type="button"
          class="mobile-menu-btn"
          id="mobile-menu-toggle"
          aria-label="فتح القائمة"
          aria-expanded="false"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>
      </div>

      <div class="mobile-drawer" id="mobile-drawer">
        <nav aria-label="قائمة الجوال">
          {NAV_LINKS.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div style="display:flex; gap:0.65rem; flex-wrap:wrap;">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" style="flex:1;">
            أرسل الصور واتساب
          </a>
          <a href={SITE.phoneHref} class="btn btn-accent btn-sm" style="flex:1;">
            اتصل: {SITE.phoneDisplay}
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <a href="/" class="brand-mark" style="margin-bottom:1rem;">
              <span class="brand-logo-box" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M4 20V10L12 4L20 10V20" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round" />
                  <path d="M9 20V13H15V20" stroke="#EA521F" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="brand-text-wrap">
                <span class="brand-title">{SITE.brandName}</span>
                <span class="brand-sub">{SITE.brandEn} • EGYPT</span>
              </span>
            </a>
            <p style="font-size:0.9rem; margin:0 0 1rem; color:rgba(255,255,255,0.75);">
              شركة <strong>أركان</strong> متخصصة في شراء الأثاث المنزلي والمكتبي والعفش الكامل وجميع الأجهزة الكهربائية المستعملة وكسر الزيرو والتالفة في جميع محافظات مصر بأعلى سعر ودفع فوري كاش.
            </p>
            <p style="font-size:0.88rem; margin:0 0 0.4rem;">
              <strong>الهاتف وواتساب (تجريبي):</strong>{' '}
              <a href={SITE.phoneHref} style="color:#ff9c78; font-weight:700;" dir="ltr">{SITE.phoneDisplay}</a>
            </p>
            <p style="font-size:0.84rem; margin:0; color:rgba(255,255,255,0.65);">{SITE.workingHours}</p>
          </div>

          <div class="footer-col">
            <h4>شراء الأثاث المستعمل</h4>
            <ul class="footer-links">
              {FOOTER_COLUMNS.furniture.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-col">
            <h4>شراء الأجهزة الكهربائية</h4>
            <ul class="footer-links">
              {FOOTER_COLUMNS.appliances.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-col">
            <h4>التغطية وأدلة الأسعار</h4>
            <ul class="footer-links">
              {FOOTER_COLUMNS.coverageAndGuides.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {SITE.brandFullName}. جميع الحقوق محفوظة.</span>
          <div style="display:flex; gap:1.25rem;">
            <a href="/how-it-works">كيف نعمل</a>
            <a href="/about">من نحن</a>
            <a href="/blog">المدونة</a>
            <a href="/contact">تواصل معنا</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Sticky CRO Action Bar -->
    <div class="mobile-sticky-bar" aria-label="تواصل سريع">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
        واتساب (تقييم بالصور)
      </a>
      <a href={SITE.phoneHref} class="btn btn-accent btn-sm">
        اتصل الآن
      </a>
    </div>

    <script is:inline>
      const header = document.getElementById('site-header');
      const toggle = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      if (header && !header.classList.contains('solid')) {
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
      if (toggle && drawer) {
        toggle.addEventListener('click', () => {
          const open = drawer.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }
    </script>
  </body>
</html>
